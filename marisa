#!/bin/bash

# 脚本所在目录（不 cd，让用户可以在任意目录下使用）
SELF_FILENAME=$0
if type readlink >/dev/null 2>&1; then
    SELF_FILENAME=$(readlink -f "$0")
fi
SCRIPT_DIR="$(cd "$(dirname "$SELF_FILENAME")" && pwd)"

export PYTHONUTF8=1
export PYTHONUNBUFFERED=1

# 检测 Python
# 坑：Windows 的「应用执行别名」（App Execution Aliases）会把 python3 / python
# 指向微软商店的 stub —— 用 type/where 探测得到，但一执行就弹商店，而不是跑 Python。
# 所以这里不能只看命令是否存在，而要实际跑一次 --version：
# 只有能正常输出「Python 3.x」的候选才会被采用（stub 只会输出
# "Python was not found..." 之类的提示，匹配不上）。
_python_ok() {
    type "$1" >/dev/null 2>&1 || return 1
    "$1" --version 2>&1 | grep -q -E '^Python 3\.'
}

_PYTHON=""
for _cand in python3 python py; do
    if _python_ok "$_cand"; then
        _PYTHON="$_cand"
        break
    fi
done

if [ -z "$_PYTHON" ]; then
    echo "DA☆ZE☆！既没找到 python3 也没找到 python，这可没法施法了！"
    exit 1
fi

# 检测 winpty（可选，用来在 mintty 中提供伪终端，让原生 Windows 程序能交互）
# winpty 仅适用于「交互式终端」场景；当 stdin 是管道/重定向（非 TTY）时，
# 直接用 winpty 会报 "stdin: not a tty" 之类的错误，此时必须绕过 winpty，
# 让 Python 自己通过非 TTY 逻辑读取管道输入。
_WINPTY=""
if type winpty >/dev/null 2>&1 && [ -t 0 ]; then
    _WINPTY="winpty"
fi

# 发动魔法！
$_WINPTY $_PYTHON "$SCRIPT_DIR/ai_agent_prompt.py" "$@"
