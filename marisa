#!/bin/bash

# 脚本所在目录（不 cd，让用户可以在任意目录下使用）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

export PYTHONUTF8=1
export PYTHONUNBUFFERED=1

# 检测 Python
_PYTHON=""
if type python3 >/dev/null 2>&1; then
    _PYTHON="python3"
elif type python >/dev/null 2>&1; then
    _PYTHON="python"
else
    echo "DA☆ZE☆！既没找到 python3 也没找到 python，这可没法施法了！"
    exit 1
fi

# 检测 winpty（可选，用来在 mintty 中提供伪终端，让原生 Windows 程序能交互）
# winpty 仅适用于「交互式终端」场景；当 stdin 是管道/重定向（非 TTY）时，
# 直接用 winpty 会报 "stdin: not a tty" 之类的错误，此时必须绕过 winpty，
# 让 Python 自己通过非 TTY 逻辑读取管道输入。
_WINPTY=""
if type winpty >/dev/null 2>&1 && [ -t 0 ]; then
    _WINPTY="winpty"
fi

# 发动魔法！
$_WINPTY $_PYTHON "$SCRIPT_DIR/ai_agent_prompt.py" "$@"
